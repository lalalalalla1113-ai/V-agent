                            ),
                        ],
                        spacing=6, tight=True,
                    ),
                    ft.Container(height=4),
                    ft.Row(
                        controls=[
                            ft.Icon(ft.Icons.REFRESH_ROUNDED, size=14,
                                    color=theme.TEXT_MUTED),
                            ft.Text(
                                "Подписку можно отменить в любой момент.",
                                size=11, color=theme.TEXT_MUTED,
                            ),
                        ],
                        spacing=6, tight=True,
                    ),
                ],
                spacing=0, tight=True,
            ),
            padding=ft.padding.symmetric(horizontal=24, vertical=16),
        )

        content_col = ft.Column(
            controls=[
                header,
                plans_block,
                features_block,
                payment_block,
                info_block,
                ft.Container(height=60),
            ],
            spacing=0,
            expand=True,
            scroll=ft.ScrollMode.AUTO,
        )

        main_layer = ft.Container(
            content=content_col,
            expand=True,
            bgcolor=ft.Colors.with_opacity(0.6, theme.BG_DARK),
        )

        return ft.Container(
            content=ft.Stack(
                controls=[bg_layer, main_layer],
                expand=True,
            ),
            expand=True,
        )

    # ---------- Тарифы ----------

    def _render_plans(self) -> None:
        self.plans_row.controls.clear()
        self._plan_widgets.clear()

        for plan in PLANS:
            is_active = plan["id"] == self.selected_plan_id
            card, ref = self._make_plan_card(plan, is_active)
            self.plans_row.controls.append(card)
            self._plan_widgets[plan["id"]] = ref

        self._update_selected_label()

    def _make_plan_card(self, plan: dict, is_active: bool):
        color = plan["color"]
        badge_text = plan.get("badge", "")
        discount_text = plan.get("discount", "")

        bg = (
            ft.Colors.with_opacity(0.15, color) if is_active
            else ft.Colors.with_opacity(0.7, theme.SURFACE)
        )
        border = color if is_active else theme.DRAWER_ITEM_BORDER

        controls = []

        if badge_text:
            controls.append(
                ft.Container(
                    content=ft.Text(
                        badge_text, size=9,
                        weight=ft.FontWeight.BOLD,
                        color=ft.Colors.WHITE,
                        text_align=ft.TextAlign.CENTER,
                    ),
                    padding=ft.padding.symmetric(horizontal=8, vertical=3),
                    bgcolor=color,
                    border_radius=6,
                )
            )
            controls.append(ft.Container(height=8))

        controls.append(
            ft.Text(
                plan["title"], size=16,
                weight=ft.FontWeight.BOLD,
                color=theme.TEXT_PRIMARY,
                text_align=ft.TextAlign.CENTER,
            )
        )
        controls.append(ft.Container(height=6))
        controls.append(
            ft.Text(
                plan["price"], size=24,
                weight=ft.FontWeight.BOLD,
                color=color,
                text_align=ft.TextAlign.CENTER,
            )
        )
        controls.append(
            ft.Text(
                plan["price_sub"], size=11,
                color=theme.TEXT_SECONDARY,
                text_align=ft.TextAlign.CENTER,
            )
        )
        controls.append(ft.Container(height=2))
        controls.append(
            ft.Text(
                plan["period"], size=10,
                color=theme.TEXT_MUTED,
                text_align=ft.TextAlign.CENTER,
            )
        )

        if discount_text:
            controls.append(ft.Container(height=6))
            controls.append(
                ft.Text(
                    discount_text, size=10,
                    color=theme.SUCCESS,
                    weight=ft.FontWeight.BOLD,
                    text_align=ft.TextAlign.CENTER,
                )
            )

        controls.append(ft.Container(expand=True))

        controls.append(
            ft.Container(
                content=ft.Row(
                    controls=[
                        ft.Icon(ft.Icons.STAR_ROUNDED, size=12,
                                color="#FFC107"),
                        ft.Text(
                            plan["stars"], size=11,
                            color=theme.TEXT_SECONDARY,
                        ),
                    ],
                    spacing=4, tight=True,
                    alignment=ft.MainAxisAlignment.CENTER,
                ),
                padding=ft.padding.only(top=6),
            )
        )

        container = ft.Container(
            content=ft.Column(
                controls=controls,
                spacing=0, tight=True,
                horizontal_alignment=ft.CrossAxisAlignment.CENTER,
            ),
            width=170, height=240,
            padding=ft.padding.all(14),
            bgcolor=bg,
            border=ft.border.all(2, border),
            border_radius=16,
            on_click=lambda e, pid=plan["id"]: self._select_plan(pid),
            ink=True,
            animate_scale=ft.Animation(150, ft.AnimationCurve.EASE_OUT),
            scale=1.0,
            on_hover=self._hover_scale,
        )

        ref = {"container": container, "color": color}
        return container, ref

    def _hover_scale(self, e: ft.ControlEvent) -> None:
        try:
            ctrl = e.control
            if e.data == "true":
                ctrl.scale = 1.03
            else:
                ctrl.scale = 1.0
            ctrl.update()
        except Exception:
            pass

    def _select_plan(self, plan_id: str) -> None:
        if self.selected_plan_id == plan_id:
            return
        self.selected_plan_id = plan_id
        self._render_plans()
        try:
            self.page.update()
        except Exception:
            pass

    def _update_selected_label(self) -> None:
        for p in PLANS:
            if p["id"] == self.selected_plan_id:
                self.selected_plan_label.value = (
                    f"Выбрано: {p['title']} — {p['price']} "
                    f"({p['stars']})"
                )
                self.selected_plan_label.color = theme.TEXT_SECONDARY
                return
        self.selected_plan_label.value = "Выбери тариф"

    # ---------- Карточка возможностей ----------

    def _make_features_card(
        self, title: str, items: list, color: str, always_free: bool,
    ) -> ft.Container:
        rows = []
        for icon, text in items:
            rows.append(
                ft.Row(
                    controls=[
                        ft.Icon(icon, size=16, color=color),
                        ft.Container(
                            content=ft.Text(
                                text, size=12,
                                color=theme.TEXT_PRIMARY,
                            ),
                            expand=True,
                            margin=ft.margin.only(left=8),
                        ),
                    ],
                    spacing=0,
                    vertical_alignment=ft.CrossAxisAlignment.CENTER,
                )
            )

        header_controls = [
            ft.Container(
                content=ft.Text(
                    "FREE" if always_free else "PREMIUM",
                    size=9, weight=ft.FontWeight.BOLD,
                    color=ft.Colors.WHITE,
                ),
                padding=ft.padding.symmetric(horizontal=8, vertical=3),
                bgcolor=(theme.PRIMARY if always_free else "#FF9800"),
                border_radius=6,
            ),
            ft.Container(width=8),
            ft.Text(
                title, size=13, weight=ft.FontWeight.BOLD,
                color=theme.TEXT_PRIMARY,
            ),
        ]

        return ft.Container(
            content=ft.Column(
                controls=[
                    ft.Row(
                        controls=header_controls,
                        spacing=0,
                        vertical_alignment=ft.CrossAxisAlignment.CENTER,
                    ),
                    ft.Container(height=10),
                    ft.Column(controls=rows, spacing=8, tight=True),
                ],
                spacing=0, tight=True,
            ),
            padding=ft.padding.all(14),
            bgcolor=theme.SURFACE,
            border=ft.border.all(
                1,
                ft.Colors.with_opacity(0.4, color),
            ),
            border_radius=14,
        )

    # ---------- Кнопки оплаты ----------

    def _make_payment_buttons(self) -> ft.Column:
        def _stub(provider: str):
            def handler(e):
                plan = self._get_selected_plan()
                plan_title = plan["title"] if plan else "—"
                plan_price = plan["price"] if plan else "—"

                self.page.open(ft.SnackBar(
                    content=ft.Text(
                        f"Оплата через «{provider}» появится в ближайшем "
