                        f"Сумма: {plan_price}"
                    ),
                    duration=3500,
                    bgcolor=theme.SURFACE,
                ))
            return handler

        def _telegram_stars(e):
            plan = self._get_selected_plan()
            plan_title = plan["title"] if plan else "—"
            plan_stars = plan["stars"] if plan else "—"
            self.page.open(ft.SnackBar(
                content=ft.Text(
                    f"Оплата Telegram Stars — в разработке.\n\n"
                    f"Тариф: {plan_title}\nСтоимость: {plan_stars}"
