class SubscriptionScreen:
    def __init__(self, page: ft.Page) -> None:
        self.page = page
        self.mobile = self._is_mobile()
        self._bg_effect = None
        self._stopped = False
        self.selected_plan_id: str = "year"

        self.plans_row = ft.Row(
            controls=[],
            spacing=12,
            run_spacing=12,
            wrap=True,
            alignment=ft.MainAxisAlignment.CENTER,
        )
        self.selected_plan_label = ft.Text(
            "Выбери тариф",
            size=12,
            color=theme.TEXT_SECONDARY,
            text_align=ft.TextAlign.CENTER,
        )
        self._plan_widgets: dict = {}

        self._render_plans()

    # ---------- Утилиты ----------

    def _is_mobile(self) -> bool:
        try:
            if self.page.platform in ("android", "ios"):
                return True
        except Exception:
            pass
        try:
            w = int(self.page.width or 0)
            return 0 < w < 700
        except Exception:
            return False

    def stop_effect(self) -> None:
        self._stopped = True
        if self._bg_effect is not None:
            try:
                self._bg_effect.stop()
            except Exception:
                pass
            self._bg_effect = None

    # ---------- Построение ----------

    def build(self) -> ft.Container:
        profile = get_current()
        effect_key = (profile.bg_effect if profile else "snow") or "snow"
        count_scale = float(profile.bg_count_scale) if profile else 1.0
        size_scale = float(profile.bg_size_scale) if profile else 1.0

        try:
            ww = int(self.page.window.width or self.page.width or 1920)
            wh = int(self.page.window.height or self.page.height or 1080)
        except Exception:
            ww, wh = 1920, 1080

        if self._bg_effect is None:
            self._bg_effect = create_effect(
                effect_key, self.page,
                width=ww, height=wh,
                count_scale=count_scale,
                size_scale=size_scale,
            )
            self._bg_effect.start()
        else:
            try:
                self._bg_effect.resume()
            except Exception:
                pass
        bg_layer = self._bg_effect.build()

        top_pad = 32 if self.mobile else 0

        # ---------- Заголовок ----------
        header = ft.Container(
            content=ft.Column(
                controls=[
                    ft.Container(
                        content=ft.Icon(
                            ft.Icons.WORKSPACE_PREMIUM_ROUNDED,
                            size=40, color=ft.Colors.WHITE,
                        ),
                        width=80, height=80, border_radius=24,
                        bgcolor=theme.PRIMARY,
                        alignment=ft.alignment.center,
                        shadow=ft.BoxShadow(
                            spread_radius=2,
                            blur_radius=20,
                            color=ft.Colors.with_opacity(0.5, theme.PRIMARY),
                        ),
                    ),
                    ft.Container(height=16),
                    ft.Text(
                        "V-AGENT Premium",
                        size=28, weight=ft.FontWeight.BOLD,
                        color=theme.TEXT_PRIMARY,
                        text_align=ft.TextAlign.CENTER,
                    ),
                    ft.Container(height=6),
                    ft.Text(
                        "Разблокируй все возможности и экономь время",
                        size=13, color=theme.TEXT_SECONDARY,
                        text_align=ft.TextAlign.CENTER,
                    ),
                ],
                spacing=0, tight=True,
                horizontal_alignment=ft.CrossAxisAlignment.CENTER,
            ),
            padding=ft.padding.only(
                left=24, right=24, top=top_pad + 24, bottom=20,
            ),
        )

        # ---------- Тарифы ----------
        plans_block = ft.Container(
            content=ft.Column(
                controls=[
                    ft.Text(
                        "Выбери тариф",
                        size=14, weight=ft.FontWeight.BOLD,
                        color=theme.TEXT_PRIMARY,
                        text_align=ft.TextAlign.CENTER,
                    ),
                    ft.Container(height=14),
                    self.plans_row,
                ],
                spacing=0, tight=True,
                horizontal_alignment=ft.CrossAxisAlignment.CENTER,
            ),
            padding=ft.padding.symmetric(horizontal=24, vertical=8),
        )

        # ---------- Что входит ----------
        features_block = ft.Container(
            content=ft.Column(
                controls=[
                    ft.Text(
                        "Что входит в подписку",
                        size=14, weight=ft.FontWeight.BOLD,
                        color=theme.TEXT_PRIMARY,
                    ),
                    ft.Container(height=12),
                    self._make_features_card(
                        title="Базовые возможности",
                        items=FEATURES_BASE,
                        color=theme.PRIMARY,
                        always_free=True,
                    ),
                    ft.Container(height=10),
                    self._make_features_card(
                        title="Только в Premium",
                        items=FEATURES_PREMIUM,
                        color="#FF9800",
                        always_free=False,
                    ),
                ],
                spacing=0, tight=True,
            ),
            padding=ft.padding.symmetric(horizontal=24, vertical=12),
        )

        # ---------- Оплата ----------
        payment_block = ft.Container(
            content=ft.Column(
                controls=[
                    ft.Text(
                        "Способ оплаты",
                        size=14, weight=ft.FontWeight.BOLD,
                        color=theme.TEXT_PRIMARY,
                    ),
                    ft.Container(height=6),
                    self.selected_plan_label,
                    ft.Container(height=12),
                    self._make_payment_buttons(),
                ],
                spacing=0, tight=True,
            ),
            padding=ft.padding.symmetric(horizontal=24, vertical=12),
        )

        # ---------- Информация ----------
        info_block = ft.Container(
            content=ft.Column(
                controls=[
                    ft.Row(
                        controls=[
                            ft.Icon(ft.Icons.LOCK_ROUNDED, size=14,
                                    color=theme.TEXT_MUTED),
                            ft.Text(
                                "Оплата защищена. Данные не передаются третьим лицам.",
