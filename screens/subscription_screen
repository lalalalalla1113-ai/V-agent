                duration=3500,
                bgcolor=theme.SURFACE,
            ))

        buttons = [
            ft.Container(
                content=ft.Row(
                    controls=[
                        ft.Icon(ft.Icons.SEND_ROUNDED, size=20,
                                color=ft.Colors.WHITE),
                        ft.Text(
                            "Telegram Stars", size=14,
                            weight=ft.FontWeight.BOLD,
                            color=ft.Colors.WHITE,
                        ),
                        ft.Container(expand=True),
                        ft.Icon(ft.Icons.CHEVRON_RIGHT_ROUNDED, size=20,
                                color=ft.Colors.WHITE),
                    ],
                    spacing=12,
                    vertical_alignment=ft.CrossAxisAlignment.CENTER,
                ),
                padding=ft.padding.symmetric(horizontal=18, vertical=16),
                bgcolor="#229ED9",
                border_radius=12,
                on_click=_telegram_stars,
                ink=True,
            ),
            ft.Container(height=10),
            ft.Container(
                content=ft.Row(
                    controls=[
                        ft.Icon(ft.Icons.CREDIT_CARD_ROUNDED, size=20,
                                color=ft.Colors.WHITE),
                        ft.Text(
                            "Банковская карта", size=14,
                            weight=ft.FontWeight.BOLD,
                            color=ft.Colors.WHITE,
                        ),
                        ft.Container(expand=True),
                        ft.Icon(ft.Icons.CHEVRON_RIGHT_ROUNDED, size=20,
                                color=ft.Colors.WHITE),
                    ],
                    spacing=12,
                    vertical_alignment=ft.CrossAxisAlignment.CENTER,
                ),
                padding=ft.padding.symmetric(horizontal=18, vertical=16),
                bgcolor=theme.PRIMARY,
                border_radius=12,
                on_click=_stub("Банковская карта"),
                ink=True,
            ),
            ft.Container(height=10),
            ft.Container(
                content=ft.Row(
                    controls=[
                        ft.Icon(ft.Icons.CURRENCY_BITCOIN_ROUNDED, size=20,
                                color=ft.Colors.WHITE),
                        ft.Text(
                            "Криптовалюта", size=14,
                            weight=ft.FontWeight.BOLD,
                            color=ft.Colors.WHITE,
                        ),
                        ft.Container(expand=True),
                        ft.Icon(ft.Icons.CHEVRON_RIGHT_ROUNDED, size=20,
                                color=ft.Colors.WHITE),
                    ],
                    spacing=12,
                    vertical_alignment=ft.CrossAxisAlignment.CENTER,
                ),
                padding=ft.padding.symmetric(horizontal=18, vertical=16),
                bgcolor="#F7931A",
                border_radius=12,
                on_click=_stub("Криптовалюта"),
                ink=True,
            ),
            ft.Container(height=10),
            ft.Container(
                content=ft.Row(
                    controls=[
                        ft.Icon(ft.Icons.ACCOUNT_BALANCE_ROUNDED, size=20,
                                color=theme.TEXT_PRIMARY),
